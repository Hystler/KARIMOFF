ADMIN_PHONE=+79999999999
# Generate outside Git with: npm run admin:credential:generate -- --output=/secure/path/admin.env
ADMIN_PASSWORD_HASH=

DATABASE_URL=
APP_ORIGIN=https://example.com
MAINTENANCE_MODE=false
TEST_ORDER_MODE=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_CDN_BASE_URL=

SESSION_SECRET=
AUTH_RATE_LIMIT_SECRET=

VERIFICATION_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
# Reserved until owner enrollment and recovery codes are implemented.
ADMIN_TOTP_SECRET=

# Telegram OIDC Authorization Code + PKCE. Server-only credentials from BotFather Web Login.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=

# MAX Bot + Mini App. All values are server-side; never expose the bot token as NEXT_PUBLIC_*.
MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_MINI_APP_URL=https://example.com/integrations/max/app

PAYMENTS_ENABLED=false
# YooKassa credentials are server-only. Use separate test-shop credentials outside production.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_URL=https://example.com/api/webhooks/yookassa
YOOKASSA_RETURN_URL=https://example.com/checkout/payment/return

EVOTOR_ENABLED=false
# Shared Bearer token configured both in Evotor integration settings and Timeweb.
EVOTOR_WEBHOOK_AUTH_TOKEN=
# 32 random bytes encoded as base64 or 64 hexadecimal characters. Server-only.
EVOTOR_TOKEN_ENCRYPTION_KEY=
# Optional comma-separated previous keys used only during a controlled rotation.
EVOTOR_TOKEN_PREVIOUS_ENCRYPTION_KEYS=
# Enable only after every old application instance can read the primary key format.
EVOTOR_TOKEN_REENCRYPT_LEGACY=false
# Отдельный bearer-secret для Timeweb scheduler, который вызывает incremental/reconciliation sync.
EVOTOR_SYNC_SECRET=
# Включает worker только в постоянно работающем Node.js-контейнере.
EVOTOR_BACKGROUND_SYNC=false
EVOTOR_INCREMENTAL_INTERVAL_SECONDS=120
EVOTOR_RECONCILIATION_INTERVAL_HOURS=6

# Optional server-only JSON keyed by "default" or a location ID.
# Configure dayparts and analytical thresholds without changing code.
ANALYTICS_CONFIG_JSON=
